# RSSHub X/Twitter route authentication. Keep the real token in .env only.
TWITTER_AUTH_TOKEN=

# Optional alternatives when the X Web API is unavailable from this network.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_THIRD_PARTY_API=
RSSHUB_PROXY_URI=
HORIZON_HTTP_PROXY=

# Reddit public RSS is rate-limited; keep subreddit requests serial.
HORIZON_REDDIT_CONCURRENCY=1
HORIZON_REDDIT_MIN_INTERVAL_SECONDS=2
HORIZON_REDDIT_RETRIES=1
HORIZON_REDDIT_RETRY_BACKOFF_SECONDS=5

# Reddit application-only OAuth. Create an app at reddit.com/prefs/apps.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:infordetection:v1.0 (by /u/your_reddit_username)
