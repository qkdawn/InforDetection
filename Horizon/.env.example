# Environment Variables

# AI API Keys (configure at least one)
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
AZURE_OPENAI_API_KEY=xxx

# Optional AI concept images for report cards.
HORIZON_IMAGE_GENERATION_ENABLED=false
HORIZON_IMAGE_BASE_URL=https://api.openai.com/v1
HORIZON_IMAGE_API_KEY_ENV=OPENAI_API_KEY
HORIZON_IMAGE_MODEL=gpt-image-2
HORIZON_IMAGE_SIZE=1536x1024
# Daily cover artwork is portrait; the report template crops it to 1080x1440.
HORIZON_COVER_IMAGE_SIZE=1024x1536
# Each accepted card also gets a native ultra-wide relationship-flow image.
HORIZON_MECHANISM_IMAGE_SIZE=1792x768
# The final image2 pass sees the two card images and creates a text-free
# portrait atmosphere plate behind the stable HTML typography.
HORIZON_COMPOSITION_IMAGE_ENABLED=true
HORIZON_COMPOSITION_IMAGE_SIZE=1024x1536
HORIZON_IMAGE_QUALITY=low
HORIZON_COVER_IMAGE_QUALITY=medium
HORIZON_COMPOSITION_IMAGE_QUALITY=low
HORIZON_IMAGE_CONCURRENCY=1
HORIZON_IMAGE_TIMEOUT_SECONDS=240
HORIZON_IMAGE_RETRY_ATTEMPTS=4
# Final multi-image composition is optional; fail fast and keep the stable card.
HORIZON_IMAGE_EDIT_RETRY_ATTEMPTS=1
# auto tries the Images edit endpoint, then a Responses-compatible image route.
HORIZON_IMAGE_EDIT_TRANSPORT=auto
HORIZON_IMAGE_RETRY_BACKOFF_SECONDS=4
# Set false when the configured HTTP proxy is unavailable; direct HTTPS is supported.
HORIZON_IMAGE_TRUST_ENV=true
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
GOOGLE_API_KEY=xxx
MINIMAX_API_KEY=xxx
DASHSCOPE_API_KEY=xxx
DOUBAO_API_KEY=xxx
DEEPSEEK_API_KEY=xxx

# WebHook Url (optional for sending notifications)
HORIZON_WEBHOOK_URL=https://xxx

# GitHub Token (optional but recommended for higher rate limits)
# Without token: 60 requests/hour
# With token: 5000 requests/hour
GITHUB_TOKEN=ghp_xxx

# Apify Token (required for Twitter scraping)
# Get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxx

# RSS fetch resilience. RSSHub serializes requests per X auth token, so keep
# the X route concurrency at 1 unless the RSSHub instance has multiple tokens.
HORIZON_RSS_CONCURRENCY=8
HORIZON_RSS_RETRIES=2
HORIZON_RSS_RETRY_BACKOFF=0.35
HORIZON_REDDIT_CONCURRENCY=1
HORIZON_REDDIT_MIN_INTERVAL_SECONDS=2
HORIZON_REDDIT_RETRIES=1
HORIZON_REDDIT_RETRY_BACKOFF_SECONDS=5
HORIZON_RSSHUB_TWITTER_CONCURRENCY=1
HORIZON_RSSHUB_TWITTER_TIMEOUT=90

# Reddit application-only OAuth (recommended when public RSS is rate-limited).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:infordetection:v1.0 (by /u/your_reddit_username)
