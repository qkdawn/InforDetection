{
  "id": "game-tech-daily",
  "name": "Game Ideas Radar",
  "display_names": {
    "zh": "游戏创意雷达"
  },
  "match": "match.md",
  "analysis": "analysis.md",
  "editorial": "editorial.md",
  "insight": "insight.md",
  "systems": "systems.md",
  "filter": {
    "enabled": true,
    "threshold": 7.0
  },
  "content": {
    "analysis_max_chars": 12000,
    "enrichment_max_chars": 18000,
    "sampling": "head-middle-tail"
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "insight_block": "fresh_relationship",
    "systems_block": "systems_question",
    "blocks": [
      {
        "id": "what_happened",
        "type": "section",
        "tools": ["web_search"],
        "primary": true
      },
      {
        "id": "fresh_relationship",
        "type": "section",
        "tools": ["web_search"]
      },
      {
        "id": "systems_question",
        "type": "section",
        "tools": []
      }
    ]
  }
}
